# Server
PORT=3000
BASE_URL=http://localhost:3000

# Secret used to HMAC-sign ticket tokens. Use a long random string in production.
# If unset, a random secret is generated once and stored in data/.ticket-secret
TICKET_SECRET=

# Shared key organizers enter on the /organizer portal
ORGANIZER_KEY=organizer123

# Email delivery mode: smtp | ethereal | none
#   smtp     -> real provider via SMTP (Brevo, SendGrid, Resend, Gmail, Mailgun...)
#   ethereal -> free Ethereal test inbox, every send gets a preview URL (default if SMTP_HOST is empty)
#   none     -> skip sending (CI/tests)
MAIL_MODE=ethereal

# SMTP settings (used when MAIL_MODE=smtp)
# Brevo:    smtp-relay.brevo.com : 587   user = your Brevo login, pass = SMTP key
# SendGrid: smtp.sendgrid.net    : 587   user = "apikey",         pass = API key
# Resend:   smtp.resend.com      : 465   user = "resend",         pass = API key
# Gmail:    smtp.gmail.com       : 587   user = address,          pass = App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Campus Events <tickets@example.edu>"

# Database. Leave empty to use local SQLite (data/tickets.db).
# On Vercel set this to a Postgres connection string (Neon, Supabase, etc.).
DATABASE_URL=
